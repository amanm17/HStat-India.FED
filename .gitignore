# secrets
.env
.env.*
!.env.example
.dev.vars

# build/runtime artifacts
dist/
node_modules/
*.log
*.pyc
*.tsbuildinfo
__pycache__/
.pytest_cache/
.venv/
.wrangler/
.DS_Store

# local checkpoints/cache
.checkpoints/
backup/

# non-published/raw data
# The Comtrade raw store lives under data/raw/store and is rebuilt by the
# pull; staging snapshots are promoted, not committed.
data/raw/
data/staging/

# The canonical ITC(HS)-8 file is a deliberate, reviewable commit; the
# loose exports it is built from are not.
data/dgcis/incoming/
data/dgcis/normalized/
# The DGCIS extract is downloaded by hand through a CAPTCHA, so the working
# file, its timestamped archives and the processed intermediates are local.
# What ships is public/data/dgcis, which is generated from them and is small.
# Keep the raw archives somewhere durable outside the repo - they are the only
# record of what the portal actually served on a given day.
data/dgcis/raw/
data/dgcis/processed/
data/dgcis/tia_network_log.json
data/dgcis/tia_capture.json
data/dgcis/tia_capture.txt

# Fixture inputs are fabricated. They exist so the pipeline and the dashboard
# can be exercised offline, and must never be mistaken for the real thing:
# config/fx_inr_usd.csv carries only citable rates, and india_hs8.csv is a
# deliberate, reviewable commit.
config/fx_inr_usd.fixture.csv
data/dgcis/india_hs8.fixture.csv

# Call error log: append-only evidence of a struggling source, useful locally
# and in a workflow artifact, not something to commit.
data/logs/

_to_delete/

# Working files that sit in the repo but are not part of it. ship.sh stages
# with `git add -A`, so anything untracked here lands in a deploy commit.
Claude outputs/
pipeline/HStat_Pipeline_Code_Guide.docx

# QA scratch: the browser suite builds doctored copies of dist to test what
# happens when the DGCIS layer is missing or stale. The scripts are tracked;
# what they produce is not.
qa/dist-test*/
qa/*.png
data/dgcis/_superseded/

# Local Comtrade availability cache
/data/comtrade/
